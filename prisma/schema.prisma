generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Country {
  id          String       @id @default(cuid())
  name        String       @unique
  code        String       @unique
  flagUrl     String?
  region      String
  description String?
  capital     String?
  currency    String?
  population  BigInt?
  gdp         Float?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  marketData  MarketData[]
  metrics     Metric[]
  news        News[]
}

model Metric {
  id        String   @id @default(cuid())
  name      String
  value     Float
  unit      String
  date      DateTime
  countryId String
  country   Country  @relation(fields: [countryId], references: [id])

  @@index([countryId, date])
}

model MarketData {
  id        String   @id @default(cuid())
  symbol    String
  type      String
  price     Float
  change    Float?
  changePct Float?
  volume    BigInt?
  timestamp DateTime @default(now())
  countryId String?
  country   Country? @relation(fields: [countryId], references: [id])

  @@index([symbol, timestamp])
}

model News {
  id          String   @id @default(cuid())
  title       String
  content     String
  summary     String?
  url         String?
  imageUrl    String?
  publishedAt DateTime @default(now())
  countryId   String?
  category    String?
  country     Country? @relation(fields: [countryId], references: [id])
}

model Currency {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  symbol      String
  countryCode String
  rateToUSD   Float
  lastUpdated DateTime @default(now())

  @@index([code])
}

model ChatMessage {
  id        String   @id @default(cuid())
  user      String
  text      String
  isAdmin   Boolean  @default(false)
  timestamp DateTime @default(now())
  userId    String?
  author    User?    @relation(fields: [userId], references: [id])

  @@index([timestamp])
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String?
  avatarUrl    String?
  role         Role          @default(USER)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  messages     ChatMessage[]
}

model Poll {
  id         String       @id @default(cuid())
  question   String
  totalVotes Int          @default(0)
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())
  options    PollOption[]
}

model PollOption {
  id     String @id @default(cuid())
  text   String
  votes  Int    @default(0)
  pollId String
  poll   Poll   @relation(fields: [pollId], references: [id])
}

model Stream {
  id           String     @id @default(cuid())
  title        String
  description  String?
  url          String
  thumbnailUrl String?
  type         StreamType @default(LIVE)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Research {
  id          String   @id @default(cuid())
  title       String
  category    String
  summary     String
  fullContent String
  icon        String
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  country     String
  countryCode String
  category    String
  date        DateTime
  time        String?
  impact      String   @default("medium")
  actual      String?
  forecast    String?
  previous    String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([countryCode])
}

enum Role {
  USER
  ADMIN
}

enum StreamType {
  LIVE
  PRE_RECORDED
}

model ApiKey {
  id        String   @id @default(cuid())
  key       String   @unique
  client    String   // Name of the company/client
  tier      Tier     @default(STANDARD)
  requests  Int      @default(0) // Track usage
  limit     Int      @default(1000) // Monthly request limit
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

enum Tier {
  STANDARD
  GOLD
  ENTERPRISE
}
