# PostgreSQL — copy to .env.local and fill in the password
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/afconomy?schema=public"

# Dev-only: user to act as when no session cookie is present (see lib/session.ts).
# Leave empty in production.
DEV_USER_EMAIL="amina.diallo@afconomy.com"

# LiveKit
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"
NEXT_PUBLIC_LIVEKIT_URL="ws://localhost:7880"

# Meilisearch — admin key is server-only, search key is safe for the browser
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_ADMIN_KEY="afconomy_dev_master_key"
NEXT_PUBLIC_MEILISEARCH_HOST="http://localhost:7700"
NEXT_PUBLIC_MEILISEARCH_SEARCH_KEY="afconomy_dev_master_key"
